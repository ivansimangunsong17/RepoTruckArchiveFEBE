NODE_ENV=production
PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=https://app.armada.co.id,http://IP-SERVER-KANTOR:5173,http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/truck_management
PG_DUMP_PATH=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
AUTH_TOKEN_SECRET=isi-dengan-random-secret-minimal-32-karakter
PASSWORD_HASH_COST=12
UPLOAD_DIR=D:\ARMADA_SYSTEM\storage
MAX_UPLOAD_SIZE_MB=5
MAX_UPLOAD_BYTES=5242880
FILE_TRASH_RETENTION_DAYS=30
STORAGE_TEMP_MAX_HOURS=24
LOCAL_BACKUP_KEEP=7
ALLOWED_UPLOAD_EXTENSIONS=pdf,jpg,jpeg,png
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,image/jpeg,image/png

# HINO CONNECT
HINO_TOKEN_URL=https://api-dev.hino.co.id/hmsi/hmsi-std-api/v4/token
HINO_VEHICLES_URL=https://api-dev.hino.co.id/hmsi/hmsi-std-api/v4/vehicles
HINO_VEHICLE_POSITIONS_URL=https://api-dev.hino.co.id/hmsi/hmsi-std-api/v4/vehiclepositions
HINO_CLIENT_ID=
HINO_CLIENT_SECRET=
HINO_USERNAME=
HINO_PASSWORD=
HINO_IBM_CLIENT_ID=
HINO_TOKEN_CONTENT_TYPE=application/x-www-form-urlencoded
HINO_TOKEN_GRANT_TYPE=client_credentials
HINO_TOKEN_BASIC_USERNAME=
HINO_TOKEN_BASIC_PASSWORD=
# Pakai ini kalau body token dari HINO tidak memakai field standar client_id/client_secret/username/password.
HINO_TOKEN_PAYLOAD_JSON=
HINO_TOKEN_HEADERS_JSON={}
HINO_VEHICLES_METHOD=POST
HINO_VEHICLES_PAYLOAD_JSON=
HINO_VEHICLES_HEADERS_JSON={}
HINO_VEHICLE_POSITIONS_METHOD=POST
HINO_VEHICLE_POSITIONS_PAYLOAD_JSON=
HINO_VEHICLE_POSITIONS_HEADERS_JSON={}
HINO_VEHICLES_SYNC_MIN_INTERVAL_SECONDS=86400
HINO_POSITIONS_SYNC_MIN_INTERVAL_SECONDS=300
HINO_POSITIONS_SYNC_INTERVAL_MINUTES=5
HINO_AUTO_SYNC_ENABLED=false
HINO_AUTO_SYNC_VEHICLES_ENABLED=false
HINO_AUTO_SYNC_TIME=05:00
